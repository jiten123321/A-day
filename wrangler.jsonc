{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a-day",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "DayRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DayRoom"]
    }
  ],
  "observability": { "enabled": true }
}
